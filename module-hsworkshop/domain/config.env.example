# Copy to config.env and adjust before rendering. Values here are non-secret.
# WORKSHOP_DOMAIN drives the chat hostname: chat.<WORKSHOP_DOMAIN>
# Example: WORKSHOP_DOMAIN=hsworkshop.fous.ai -> chat host chat.hsworkshop.fous.ai

# The workshop domain that hosts the chat application (no scheme, no "chat." prefix).
WORKSHOP_DOMAIN=hsworkshop.fous.ai

# ACME environment: choose explicitly.
#   staging    -> Let's Encrypt STAGING directory. Certificates are NOT trusted
#                 by browsers (show security warnings). Use only to validate the
#                 DNS-01 + issuance + Route wiring end-to-end without hitting
#                 production rate limits.
#   production -> Let's Encrypt PRODUCTION directory. Issues browser-trusted
#                 certificates. Render this only AFTER a staging validation
#                 succeeded, and use it for the live chat.hsworkshop.fous.ai host.
# Default when unset: staging (safe: never silently issues trusted certs).
ACME_ENV=staging

# Contact email for the ACME account (expiry notices). No default; must be set.
# Use an address you control.
ACME_EMAIL=kpiwko@redhat.com

# Namespace for all rendered resources. Keep in sync with the base install.
NAMESPACE=hsworkshop

# DNS-only CNAME target: the cluster's public router. Verified live:
# router-default.apps.kpicl2-pool-rft8p.aws.rh-ods.com resolves to the same
# LB addresses as the existing openwebui route host.
ROUTER_DNS_TARGET=router-default.apps.kpicl2-pool-rft8p.aws.rh-ods.com
